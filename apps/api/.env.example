MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_BOOTSTRAP_TOKEN_AT_LEAST_32_CHARACTERS
