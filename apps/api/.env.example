NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://zenovel_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/zenovel_dev
DB_POOL_MAX=5
DB_TIMEOUT_MS=3000
RATE_LIMIT=60
RATE_TTL_MS=60000
PASSWORD_EXPIRY_DAYS=30
